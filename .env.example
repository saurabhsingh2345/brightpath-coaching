# ─────────────────────────────────────────────────────────────
# BrightPath Coaching - Backend environment
# Copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ── Database ────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightpath?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`.
# For plain local Postgres this is the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/brightpath?schema=public"

# Supabase (recommended for hosted). Use the *pooled* (pgbouncer, port 6543)
# connection for DATABASE_URL and the *direct* (port 5432) one for DIRECT_URL
# so that `prisma migrate` can run DDL.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────────────────────
# Comma separated list, or * for all (development only)
CORS_ORIGINS=*

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
# Public base URL the mobile app can reach files on.
# In dev with an Android emulator this is http://10.0.2.2:4000
PUBLIC_BASE_URL=http://localhost:4000

# ── Seed ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@brightpath.edu
SEED_ADMIN_PASSWORD=Admin@123
SEED_STUDENT_PASSWORD=Student@123
